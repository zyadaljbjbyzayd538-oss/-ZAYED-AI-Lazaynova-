# Copy to backend/.env locally (never commit populated secrets).
DATABASE_URL=postgres://lazaynova:lazaynova-local-only@localhost:5432/lazaynova
REDIS_URL=redis://localhost:6379
HOST=0.0.0.0
PORT=8080
SESSION_TTL_HOURS=24
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Optional server-side OpenAI-compatible gateway profile named "default" (backward-compatible).
# It may enable Chat, text-only Writing, and Model Analysis when each has an explicit profile selection.
# Remote URLs must use HTTPS; HTTP is allowed only for loopback/private container-network endpoints.
# AI_GATEWAY_BASE_URL=https://your-private-gateway.example/v1
# AI_GATEWAY_MODEL=your-model-id
# AI_GATEWAY_API_KEY=inject-through-a-secret-manager-or-local-uncommitted-env
# AI_GATEWAY_TIMEOUT_MS=30000
# Multiple private/local and commercial profiles can be selected independently; no cross-provider
# failover occurs, so sensitive prompts never silently leave the configured provider boundary.
# AI_GATEWAY_PROVIDERS=local,cloud
# AI_GATEWAY_LOCAL_BASE_URL=http://ollama:11434/v1
# AI_GATEWAY_LOCAL_MODEL=qwen2.5:7b
# For HTTP only on an isolated trusted private container network (never a public endpoint):
# AI_GATEWAY_LOCAL_ALLOW_INSECURE_HTTP=true
# AI_GATEWAY_LOCAL_API_KEY=optional-local-gateway-token
# AI_GATEWAY_CLOUD_BASE_URL=https://your-enterprise-gateway.example/v1
# AI_GATEWAY_CLOUD_MODEL=your-approved-enterprise-model
# AI_GATEWAY_CLOUD_API_KEY=inject-through-a-secret-manager-or-local-uncommitted-env
# AI_CHAT_PROVIDER=local
# AI_WRITING_PROVIDER=local
# AI_MODEL_ANALYSIS_PROVIDER=cloud
# Native provider profiles are also supported; public base URLs default from the protocol.
# AI_GATEWAY_PROVIDERS=claude,gemini
# AI_GATEWAY_CLAUDE_PROTOCOL=anthropic
# AI_GATEWAY_CLAUDE_MODEL=your-account-enabled-model-id
# AI_GATEWAY_CLAUDE_API_KEY=inject-through-a-secret-manager-or-local-uncommitted-env
# AI_GATEWAY_GEMINI_PROTOCOL=gemini
# AI_GATEWAY_GEMINI_MODEL=your-project-enabled-model-id
# AI_GATEWAY_GEMINI_API_KEY=inject-through-a-secret-manager-or-local-uncommitted-env
# AI_CHAT_PROVIDER=claude
# AI_MODEL_ANALYSIS_PROVIDER=gemini
# Optional model-backed task planner. Sends task text (bounded) to this explicitly chosen profile.
# If unset, the offline single-node capability planner is used.
# AI_PLANNER_PROVIDER=local
# Optional small-text/CSV analysis. Generate a 32-byte key with `openssl rand -hex 32` and keep it stable.
# FILE_ENCRYPTION_KEY=inject-through-a-secret-manager-or-local-uncommitted-env
# AI_FILE_ANALYSIS_PROVIDER=local
# Optional exact per-model rates. Integers are micro-USD per 1,000,000 tokens; do not guess prices.
# Unconfigured models are recorded as unpriced, never assigned a fabricated cost.
# AI_MODEL_PRICING_JSON='{"provider/model-id":{"inputMicrousdPerMillionTokens":<published-rate-in-micro-USD>,"outputMicrousdPerMillionTokens":<published-rate-in-micro-USD>}}'
# Optional Tavily per-request estimate, set from your current plan/invoice; unset means counted but unpriced.
# TAVILY_ESTIMATED_COST_MICRO_USD_PER_CALL=<operator-verified-micro-USD-per-advanced-search-request>
# Optional web research (query and source content are sent to Tavily only when explicitly configured).
# TAVILY_API_KEY=inject-through-a-secret-manager-or-local-uncommitted-env
# AI_RESEARCH_PROVIDER=local
# TAVILY_TIMEOUT_MS=20000
# Optional S3-compatible external task artifact store. All four required settings must be configured together.
# Credentials are server-only secrets; object bytes are encrypted at rest by the provider using SSE-S3 (AES256).
# Custom endpoints must be HTTPS and must not contain credentials, query strings, or fragments.
# If unset, small results remain inline and results requiring external storage fail safely (never fall back to JSONB).
# ARTIFACT_S3_BUCKET=lazaynova-private-artifacts
# ARTIFACT_S3_REGION=eu-central-1
# ARTIFACT_S3_ACCESS_KEY_ID=inject-through-a-secret-manager
# ARTIFACT_S3_SECRET_ACCESS_KEY=inject-through-a-secret-manager
# ARTIFACT_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# ARTIFACT_S3_FORCE_PATH_STYLE=false
# Optional isolated coding runtime. Requires Docker Engine with gVisor runsc and a local image pinned by digest.
# The runtime fails closed unless all four values are set; networking stays disabled (ALLOWLIST is unavailable).
# Workspaces must be pre-provisioned as <root>/<user UUID>/<project UUID>/<archive UUID> by a trusted manager, with an external hard disk quota.
# CODE_SANDBOX_DOCKER_BINARY=/usr/bin/docker
# CODE_SANDBOX_WORKSPACE_ROOT=/var/lib/lazaynova/workspaces
# CODE_SANDBOX_IMAGE=registry.example/lazaynova-sandbox@sha256:<64-hex-digest>
# CODE_SANDBOX_RUNTIME=runsc
# Required only for the one-time bootstrap command. Use a unique, strong password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
