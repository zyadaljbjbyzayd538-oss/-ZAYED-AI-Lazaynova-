{
  "name": "@zayedai/lazaynova-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lazaynova API and asynchronous capability worker",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src test --max-warnings=0",
    "migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts",
    "start:api": "node --env-file-if-exists=.env --import tsx src/api/main.ts",
    "start:worker": "node --env-file-if-exists=.env --import tsx src/workers/main.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.1",
    "bullmq": "^5.58.5",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.36.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
