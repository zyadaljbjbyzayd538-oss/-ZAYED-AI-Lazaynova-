root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.kt]
indent_size = 4
ktlint_code_style = intellij_idea
ktlint_standard_max-line-length = disabled
ktlint_standard_import-ordering = disabled

[*.kts]
indent_size = 4
ktlint_code_style = intellij_idea
ktlint_standard_max-line-length = disabled
ktlint_standard_import-ordering = disabled
