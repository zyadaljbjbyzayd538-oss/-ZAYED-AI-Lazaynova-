# Copy to infrastructure/private.env and replace secrets before starting services.
# Use URL-safe random secrets because these values are embedded in connection URLs.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_PASSWORD=replace-with-a-different-openssl-rand-hex-32
API_BIND_ADDRESS=127.0.0.1
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password-at-least-14-characters

# Version-pinned official Ollama image; verify/pin its digest during deployment review.
OLLAMA_IMAGE=ollama/ollama:0.35.0

# Local/private inference example. The Ollama model must be pulled explicitly.
AI_GATEWAY_PROVIDERS=local
AI_GATEWAY_LOCAL_BASE_URL=http://ollama:11434/v1
AI_GATEWAY_LOCAL_MODEL=qwen2.5:7b
AI_GATEWAY_LOCAL_ALLOW_INSECURE_HTTP=true
AI_CHAT_PROVIDER=local
AI_WRITING_PROVIDER=local
AI_MODEL_ANALYSIS_PROVIDER=local
# Optional model-backed planner; the user's task text is sent to this explicitly selected profile.
# If unset, the offline deterministic one-capability planner is used.
AI_PLANNER_PROVIDER=
# Optional exact model rates in integer micro-USD per million tokens. Leave blank until verified against your contract.
# Format: {"provider/model-id":{"inputMicrousdPerMillionTokens":<rate>,"outputMicrousdPerMillionTokens":<rate>}}
AI_MODEL_PRICING_JSON=
# Optional operator-verified estimated USD micro-cost per Tavily advanced-search API call.
# Leave unset when the plan rate is unknown; calls remain visible but unpriced.
TAVILY_ESTIMATED_COST_MICRO_USD_PER_CALL=

# Optional encrypted TXT/Markdown/log/CSV storage. Generate once with `openssl rand -hex 32`.
# Keep this key stable and backed up securely; changing/losing it makes existing files unreadable.
FILE_ENCRYPTION_KEY=
# File content is sent to the explicitly named model only after a FILE_ANALYSIS task is approved.
# AI_FILE_ANALYSIS_PROVIDER=local

# Optional external research. Search queries and retrieved source text go to this service;
# keep unset unless that disclosure is approved. Set AI_RESEARCH_PROVIDER=local or cloud as chosen.
TAVILY_API_KEY=
AI_RESEARCH_PROVIDER=
TAVILY_TIMEOUT_MS=20000

# To add an approved enterprise/cloud profile, use AI_GATEWAY_PROVIDERS=local,cloud
# and configure all of these through your secret manager/private env file.
AI_GATEWAY_CLOUD_BASE_URL=
AI_GATEWAY_CLOUD_MODEL=
AI_GATEWAY_CLOUD_API_KEY=
